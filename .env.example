PORT=3000
NODE_ENV=development

# ===== Supabase / Vercel Postgres (preferred on server) =====
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=postgres
POSTGRES_HOST=db.rygpumahblyktgwlfgzv.supabase.co
POSTGRES_PASSWORD=
POSTGRES_DATABASE=postgres

# Supabase API (optional — available if you use Supabase client later)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Fallback if POSTGRES_* is not set (local / legacy)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.rygpumahblyktgwlfgzv.supabase.co:5432/postgres?sslmode=require

# JWT secrets (change in production)
JWT_CUSTOMER_SECRET=change-me-customer-secret
JWT_ADMIN_SECRET=change-me-admin-secret
JWT_STAFF_SECRET=change-me-staff-secret
JWT_EXPIRES_IN=7d

# OTP (demo mode logs OTP to console)
OTP_EXPIRY_MINUTES=10
DEMO_OTP=123456

# App config
DELIVERY_FEE=30
MIN_ORDER=99

# Optional: create initial admin on db:seed (defaults used if empty)
ADMIN_EMAIL=admin@kisanmall.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin
STAFF_PIN=1234
