PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kisanmall

# JWT secrets (change in production)
JWT_CUSTOMER_SECRET=change-me-customer-secret
JWT_ADMIN_SECRET=change-me-admin-secret
JWT_STAFF_SECRET=change-me-staff-secret
JWT_EXPIRES_IN=7d

# OTP (demo mode logs OTP to console)
OTP_EXPIRY_MINUTES=10
DEMO_OTP=123456

# App config
DELIVERY_FEE=30
MIN_ORDER=99

# Optional: create initial admin on db:seed
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
